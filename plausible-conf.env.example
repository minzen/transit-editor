# Plausible Analytics configuration
# Copy this file to plausible-conf.env and fill in your actual values
# plausible-conf.env is included in .gitignore to protect sensitive information

# Required: A random secret key for encryption
# Generate one with: openssl rand -base64 48
SECRET_KEY=change-this-to-a-long-random-string

# Required: The public URL where Plausible is accessible
# Must match the DNS name you configure on your host machine
BASE_URL=https://tracking.transit-map-editor.online

# Optional: Disable public registrations after creating your admin account
DISABLE_REGISTRATION=false

# Optional: SMTP settings for password reset emails
# MAILER_EMAIL=plausible@transit-map-editor.online
# SMTP_HOST_ADDR=smtp.example.com
# SMTP_HOST_PORT=587
# SMTP_USER_NAME=your-smtp-user
# SMTP_USER_PASSWORD=your-smtp-password
# SMTP_HOST_SSL_ENABLED=true
