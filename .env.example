# Deployment configuration
# Copy this file to .env and fill in your actual values
# .env is included in .gitignore to protect sensitive information

VPS_USER=your_username
VPS_HOST=your_vps_ip_or_domain
VPS_PATH=/opt/transit-editor

# Plausible Analytics (optional)
# Set these to enable analytics tracking in the app
VITE_PLAUSIBLE_DOMAIN=your-domain.com
VITE_PLAUSIBLE_URL=http://localhost:8002
