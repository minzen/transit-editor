{
  "name": "transit-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:node": "node -e \"const major = Number(process.versions.node.split('.')[0]); if (major < 24) { console.error('Node.js 24 or newer is required. Run nvm use.'); process.exit(1) }\"",
    "predev": "npm run check:node",
    "dev": "vite",
    "prebuild": "npm run check:node",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "prelint": "npm run check:node",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "prebenchmark": "npm run check:node",
    "benchmark": "vitest run --config vitest.benchmark.config.ts",
    "pree2e": "npm run check:node",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.0.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
